{
  "name": "@sabszh/syntag-local",
  "private": false,
  "version": "0.3.2",
  "type": "module",
  "description": "Local MCP server and API for privacy-preserving Syntag image disclosure tagging.",
  "bin": {
    "syntag": "scripts/syntag-local.mjs"
  },
  "files": [
    "scripts/syntag-local.mjs",
    "src/lib/disclosure.js",
    "src/lib/xmp.js",
    "public/eu-*.svg",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabszh/syntag.eu.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "local:mcp": "node scripts/syntag-local.mjs --stdio",
    "local:api": "node scripts/syntag-local.mjs",
    "deploy": "npm run build && wrangler deploy",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "pdf-lib": "^1.17.1",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.2",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.1"
  }
}
