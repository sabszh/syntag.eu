{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syntag-eu",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "main": "src/worker.js",
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "syntag_usage" }
  ]
}
